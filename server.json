{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.radeksixi/sixi-scanner",
  "title": "Sixi Scanner",
  "description": "Zero-dependency red-team scanner and passive MCP/A2A surface & rug-pull inspector for LLM agents.",
  "version": "1.3.0",
  "repository": {
    "url": "https://github.com/radeksixi/sixi-scanner",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "sixi-scanner",
      "version": "1.3.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp-serve"
        }
      ]
    }
  ]
}
